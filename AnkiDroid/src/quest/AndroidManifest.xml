<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!-- AnkiQuest branding, merged over the main manifest only by the quest build (-PcustomSuffix=quest). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AnkiquestUpdater installs downloaded releases -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:icon="@mipmap/ankiquest_launcher"
        android:roundIcon="@mipmap/ankiquest_launcher"
        tools:replace="android:icon,android:roundIcon">
        <!-- The launcher entries are the AnkiquestIcon aliases below, so the icon can show Aki's mood. -->
        <activity android:name="com.ichi2.anki.IntentHandler">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="com.ichi2.anki.ankiquest.AnkiquestIconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ankiquest_launcher"
            android:roundIcon="@mipmap/ankiquest_launcher"
            android:targetActivity="com.ichi2.anki.IntentHandler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.ichi2.anki.ankiquest.AnkiquestIconHappy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ankiquest_launcher_happy"
            android:roundIcon="@mipmap/ankiquest_launcher_happy"
            android:targetActivity="com.ichi2.anki.IntentHandler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.ichi2.anki.ankiquest.AnkiquestIconWorried"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ankiquest_launcher_worried"
            android:roundIcon="@mipmap/ankiquest_launcher_worried"
            android:targetActivity="com.ichi2.anki.IntentHandler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.ichi2.anki.ankiquest.AnkiquestIconFrozen"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ankiquest_launcher_frozen"
            android:roundIcon="@mipmap/ankiquest_launcher_frozen"
            android:targetActivity="com.ichi2.anki.IntentHandler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.ichi2.anki.ankiquest.AnkiquestIconSleepy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ankiquest_launcher_sleepy"
            android:roundIcon="@mipmap/ankiquest_launcher_sleepy"
            android:targetActivity="com.ichi2.anki.IntentHandler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
