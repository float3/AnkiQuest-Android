<!-- AnkiQuest branding, merged over the main manifest only by the quest build (-PcustomSuffix=quest). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AnkiquestUpdater installs downloaded releases -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:icon="@mipmap/ankiquest_launcher"
        android:roundIcon="@mipmap/ankiquest_launcher"
        tools:replace="android:icon,android:roundIcon" />
</manifest>
