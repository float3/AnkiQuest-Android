<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/ankiquest_study_title"
    android:key="@string/ankiquest_study_screen_key">
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/ankiquest_open_today_key"
        android:summary="@string/ankiquest_open_today_summary"
        android:title="@string/ankiquest_open_today_title" />
    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/ankiquest_summary_preference_key"
        android:summary="@string/ankiquest_summary_preference_summary"
        android:title="@string/ankiquest_summary_preference_title" />
    <ListPreference
        android:defaultValue="backlog"
        android:entries="@array/ankiquest_goal_mode_entries"
        android:entryValues="@array/ankiquest_goal_mode_values"
        android:key="@string/ankiquest_goal_mode_key"
        android:title="@string/ankiquest_goal_mode_title"
        app:useSimpleSummaryProvider="true" />
    <ListPreference
        android:defaultValue="10"
        android:entries="@array/ankiquest_goal_backlog_entries"
        android:entryValues="@array/ankiquest_goal_backlog_values"
        android:key="@string/ankiquest_goal_backlog_key"
        android:title="@string/ankiquest_goal_backlog_title"
        app:useSimpleSummaryProvider="true" />
    <com.ichi2.preferences.IncrementerNumberRangePreferenceCompat
        android:defaultValue="100"
        android:key="@string/ankiquest_goal_cards_key"
        android:title="@string/ankiquest_goal_cards_title"
        app:min="1"
        app:max="9999"
        app:useSimpleSummaryProvider="true" />
    <com.ichi2.preferences.IncrementerNumberRangePreferenceCompat
        android:defaultValue="20"
        android:key="@string/ankiquest_goal_minutes_key"
        android:title="@string/ankiquest_goal_minutes_title"
        app:min="1"
        app:max="1440"
        app:useSimpleSummaryProvider="true" />
    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/ankiquest_deck_status_key"
        android:summary="@string/ankiquest_deck_status_summary"
        android:title="@string/ankiquest_deck_status_title" />
    <SwitchPreferenceCompat
        android:key="@string/ankiquest_streak_protection_key"
        android:persistent="false"
        android:summary="@string/ankiquest_streak_protection_summary"
        android:title="@string/ankiquest_streak_protection_title" />
</PreferenceScreen>
