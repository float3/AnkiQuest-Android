<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/ankiquest_manage_account_title"
    android:key="@string/ankiquest_sign_in_screen_key">
    <Preference
        android:key="@string/ankiquest_account_status_key"
        android:persistent="false" />
    <Preference
        android:key="@string/ankiquest_password_key"
        android:persistent="false"
        android:title="@string/ankiquest_password_title" />
    <PreferenceCategory
        android:key="@string/ankiquest_providers_key"
        android:title="@string/ankiquest_providers_title" />
    <PreferenceCategory
        android:key="@string/ankiquest_devices_key"
        android:title="@string/ankiquest_devices_title">
        <Preference
            android:key="@string/ankiquest_sign_out_others_key"
            android:persistent="false"
            android:title="@string/ankiquest_sign_out_others_title"
            android:summary="@string/ankiquest_sign_out_others_summary" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/ankiquest_data_title">
        <Preference
            android:key="@string/ankiquest_export_key"
            android:persistent="false"
            android:title="@string/ankiquest_export_title"
            android:summary="@string/ankiquest_export_summary" />
        <Preference
            android:key="@string/ankiquest_delete_account_key"
            android:persistent="false"
            android:title="@string/ankiquest_delete_title"
            android:summary="@string/ankiquest_delete_summary" />
    </PreferenceCategory>
    <!-- The account behind a manual sign-in; signing in fills these in. -->
    <PreferenceCategory
        android:key="@string/ankiquest_connection_key"
        android:title="@string/ankiquest_connection_title">
        <com.ichi2.preferences.VersatileTextPreference
            android:key="@string/ankiquest_url_key"
            android:title="@string/ankiquest_url_title"
            android:inputType="textUri"
            app:dialogHint="@string/dialog_hint_url"
            app:useSimpleSummaryProvider="true" />
        <com.ichi2.preferences.VersatileTextPreference
            android:key="@string/ankiquest_user_key"
            android:title="@string/ankiquest_user_title"
            android:inputType="text"
            app:useSimpleSummaryProvider="true" />
        <com.ichi2.preferences.VersatileTextPreference
            android:key="@string/ankiquest_token_key"
            android:title="@string/ankiquest_token_title"
            android:inputType="textPassword" />
        <Preference
            android:key="@string/ankiquest_test_key"
            android:persistent="false"
            android:title="@string/ankiquest_test_title"
            android:summary="@string/ankiquest_test_summary" />
    </PreferenceCategory>
</PreferenceScreen>
