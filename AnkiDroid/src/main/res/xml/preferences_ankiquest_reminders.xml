<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/ankiquest_community_reminders_title">
    <Preference
        android:key="@string/aq_reminders_status_key"
        android:persistent="false"
        android:selectable="false"
        android:summary="@string/aq_reminders_loading"
        app:iconSpaceReserved="false" />
    <Preference
        android:key="@string/aq_reminders_retry_key"
        android:persistent="false"
        android:title="@string/aq_reminders_retry"
        app:isPreferenceVisible="false"
        app:iconSpaceReserved="false" />
    <PreferenceCategory
        android:key="@string/aq_reminders_kinds_key"
        android:title="@string/aq_reminders_kinds"
        app:isPreferenceVisible="false"
        app:iconSpaceReserved="false" />
    <PreferenceCategory
        android:key="@string/aq_reminders_timing_key"
        android:title="@string/aq_reminders_timing"
        app:isPreferenceVisible="false"
        app:iconSpaceReserved="false" />
</PreferenceScreen>
