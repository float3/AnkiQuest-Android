<!-- 1x1: the companion's face over the number. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ankiquest_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ankiquest_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/ankiquest_streak_badge"
        android:layout_width="28dp"
        android:layout_height="28dp">

        <ProgressBar
            android:id="@+id/ankiquest_streak_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="false"
            android:progressDrawable="@drawable/ankiquest_streak_widget_ring"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ankiquest_streak_companion"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/aki_streak" />
    </FrameLayout>

    <TextView
        android:id="@+id/ankiquest_streak_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ankiquest_widget_text"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/ankiquest_streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ankiquest_streak_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
