<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp">

        <EditText
            android:id="@+id/ankiquest_sign_in_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="url"
            android:hint="@string/ankiquest_sign_in_server"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/ankiquest_sign_in_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="username"
            android:hint="@string/ankiquest_sign_in_user"
            android:inputType="textNoSuggestions|textVisiblePassword" />

        <EditText
            android:id="@+id/ankiquest_sign_in_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="password"
            android:hint="@string/ankiquest_sign_in_password"
            android:inputType="textPassword" />

        <CheckBox
            android:id="@+id/ankiquest_sign_in_create"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ankiquest_sign_in_create" />

        <EditText
            android:id="@+id/ankiquest_sign_in_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="name"
            android:hint="@string/ankiquest_sign_in_display"
            android:inputType="textPersonName"
            android:maxLength="40"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ankiquest_sign_in_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ankiquest_sign_in_hint"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ankiquest_sign_in_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
