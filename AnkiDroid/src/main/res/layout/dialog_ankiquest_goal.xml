<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp">

        <RadioGroup
            android:id="@+id/ankiquest_goal_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/ankiquest_goal_mode_backlog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ankiquest_goal_mode_backlog" />

            <RadioButton
                android:id="@+id/ankiquest_goal_mode_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ankiquest_goal_cards_title" />

            <RadioButton
                android:id="@+id/ankiquest_goal_mode_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ankiquest_goal_minutes_title" />

            <RadioButton
                android:id="@+id/ankiquest_goal_mode_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ankiquest_goal_off" />
        </RadioGroup>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/ankiquest_goal_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/ankiquest_goal_preset_7"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ankiquest_goal_preset_14"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ankiquest_goal_preset_30"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ankiquest_goal_preset_60"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ankiquest_goal_preset_custom"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ankiquest_goal_custom" />
        </com.google.android.material.chip.ChipGroup>

        <EditText
            android:id="@+id/ankiquest_goal_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:id="@+id/ankiquest_goal_estimate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="12dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/ankiquest_goal_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/ankiquest_goal_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="8dp" />
    </LinearLayout>
</ScrollView>
