<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ankiquest_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ankiquest_widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/ankiquest_streak_badge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="4dp">

        <ProgressBar
            android:id="@+id/ankiquest_streak_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="false"
            android:progressDrawable="@drawable/ankiquest_streak_widget_ring"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ankiquest_streak_companion"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/aki_streak" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ankiquest_streak_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:textColor="@color/ankiquest_widget_text"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/ankiquest_streak_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/ankiquest_streak_widget_label"
            android:textColor="@color/ankiquest_widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ankiquest_streak_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/ankiquest_widget_text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
