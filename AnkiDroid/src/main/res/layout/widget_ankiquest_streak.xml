<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ankiquest_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ankiquest_widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/ankiquest_streak_badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp">

        <ProgressBar
            android:id="@+id/ankiquest_streak_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:indeterminate="false"
            android:progressDrawable="@drawable/ankiquest_streak_widget_ring"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ankiquest_streak_companion"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/aki_streak" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ankiquest_streak_number"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="44sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-black"
            android:gravity="bottom|center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ankiquest_widget_text"
            android:textSize="44sp"
            tools:targetApi="o" />

        <TextView
            android:id="@+id/ankiquest_streak_label"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="8dp"
            android:autoSizeStepGranularity="1dp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/ankiquest_streak_widget_label"
            android:textColor="@color/ankiquest_widget_text"
            android:textSize="11sp"
            tools:targetApi="o" />

        <TextView
            android:id="@+id/ankiquest_streak_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/ankiquest_widget_text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
