<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <ImageView
            android:id="@+id/aq_recap_art"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/aq_recap_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/ankiquest_summary_title"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/aq_recap_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="?android:attr/textAppearanceMedium" />
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/aq_recap_opt_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/ankiquest_summary_dont_show_again" />
    </LinearLayout>
</ScrollView>
